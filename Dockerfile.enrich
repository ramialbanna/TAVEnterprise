# Item 74 — always-on Facebook seller enrich daemon.
# Browser runs on GoLogin Cloud; this image is Node + Puppeteer client only.
FROM node:22-bookworm-slim

WORKDIR /app
ENV NODE_ENV=production
ENV ENRICH_STATE_PATH=/data/.enrich-run-state.json

COPY package.json package-lock.json ./
RUN npm ci --omit=dev

COPY scripts/ ./scripts/

RUN mkdir -p /data

CMD ["node", "scripts/enrich-facebook-sellers.mjs", "--write", "--loop", "--cloud"]
